# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Login is by MOBILE NUMBER + OTP:  dummy (code 123456, no SMS) | sms (real SMS via Supabase)
VITE_OTP_MODE=dummy
# Any random text; only used in dummy OTP mode. Don't change it later (test accounts stop working).
VITE_DUMMY_AUTH_SALT=change-me-to-any-random-text

# Wallet recharge: dummy | razorpay
VITE_PAYMENT_MODE=dummy
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx   (public key only — the secret goes in Supabase Edge Function secrets)

# Admin panel (test mode): hidden login email is built from this address + the admin's number,
# e.g. name+fmsadmin919876543210@gmail.com. Use any real mailbox domain (gmail.com works).
VITE_ADMIN_DUMMY_EMAIL_BASE=admin.findmyschemes@gmail.com
