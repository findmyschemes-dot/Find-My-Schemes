# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Phone.Email "Sign in with Phone" button — Client ID from the Phone.Email dashboard
VITE_PHONE_EMAIL_CLIENT_ID=11408694035205611879

# Name of the Supabase Edge Function that checks Phone.Email logins (default: phone-login)
VITE_PHONE_LOGIN_FUNCTION=phone-login
