# =====================================================================
# Find My Schemes — payment server settings
# Copy this file to  server/.env  and fill in the values. NEVER commit .env.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# =====================================================================

# Which Razorpay keys to use right now:  test  or  live
RAZORPAY_MODE=test

# Razorpay Dashboard → (Test mode ON) → Account & Settings → API Keys
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Razorpay Dashboard → (Test mode ON) → Account & Settings → Webhooks → the secret typed when creating the webhook
RAZORPAY_TEST_WEBHOOK_SECRET=

# Same as above with Test mode OFF (Live)
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_LIVE_WEBHOOK_SECRET=

# Supabase → Project Settings → API  (service_role / secret key — server only, never in the website .env)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-SECRET-KEY

# Websites allowed to call this server (comma separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,https://find-my-schemes.vercel.app,https://findmyschemes.com,https://www.findmyschemes.com

# Shown in the Razorpay payment window
BRAND_NAME=Find My Schemes
BRAND_LOGO_URL=https://find-my-schemes.vercel.app/assets/Logo_icon.png
BRAND_COLOR=#16332c

# Local only (Vercel ignores it)
PORT=4000
